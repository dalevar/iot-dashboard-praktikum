                "resp_history"
            ]
        ]
    },
    {
        "id": "resp_history",
        "type": "function",
        "z": "flow_api",
        "name": "Format History",
        "func": "var rows = msg.payload || [];\n// Balik urutan agar kronologis (lama ke baru) untuk grafik\nrows.reverse();\nmsg.payload = {\n    status: 'success',\n    count: rows.length,\n    data: rows\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1260,
        "y": 270,
        "wires": [
            [
                "http_resp_global"
            ]
        ]
    },
    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "flow_api",
        "name": "Validasi & Publish Kontrol",
        "func": "var body = msg.payload;\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    return [msg, null];\n}\n\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\nreturn [msg, mqttMsg];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 320,
        "wires": [
            [
                "http_resp_global"
            ],
            [
                "mqtt_publish_kontrol"
            ]
        ]
    },
    {
        "id": "proc_threshold",
        "type": "function",
        "z": "flow_api",
        "name": "Set Threshold",
        "func": "var body = msg.payload;\nif (body.threshold === undefined || isNaN(parseFloat(body.threshold))) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'Parameter threshold (angka) wajib diisi'};\n    return msg;\n}\n\nvar newThreshold = parseFloat(body.threshold);\nflow.set('tempThreshold', newThreshold);\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: Batas suhu berhasil diatur ke ${newThreshold}°C,\n    threshold: newThreshold\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 380,
        "wires": [
            [
                "http_resp_global"
            ]
        ]
    },
