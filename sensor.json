[
    {
        "id": "flow_api",
        "type": "tab",
        "label": "IoT REST, WS & SQLite",
        "disabled": false,
        "info": ""
    },
    {
        "id": "mqtt_broker_config",
        "type": "mqtt-broker",
        "name": "Local Mosquitto",
        "broker": "localhost",
        "port": "1883",
        "clientid": "node-red-backend",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4"
    },
    {
        "id": "sqlite_db_config",
        "type": "sqlitedb",
        "db": "iot_data.db",
        "mode": "RWC"
    },
    {
        "id": "ws_listener_config",
        "type": "websocket-listener",
        "path": "/ws/sensor",
        "wholemsg": "false"
    },
    {
        "id": "inject_init_db",
        "type": "inject",
        "z": "flow_api",
        "name": "Init DB on Startup",
        "props": [
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "CREATE TABLE IF NOT EXISTS sensor_history (id INTEGER PRIMARY KEY AUTOINCREMENT, suhu REAL, kelembaban REAL, received TEXT);",
        "x": 160,
        "y": 40,
        "wires": [
            [
                "sqlite_init"
            ]
        ]
    },
    {
        "id": "sqlite_init",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlite_db_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Create Table",
        "x": 370,
        "y": 40,
        "wires": [
            []
        ]
    },
    {
        "id": "mqtt_sensor_in",
        "type": "mqtt in",
        "z": "flow_api",
        "name": "Subscribe Sensor",
        "topic": "iot/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "x": 150,
        "y": 120,
        "wires": [
            [
                "process_sensor"
            ]
        ]
    },
    {
        "id": "process_sensor",
        "type": "function",
        "z": "flow_api",
        "name": "Process, Threshold & SQL",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// Cek Threshold\nvar threshold = flow.get('tempThreshold') || 30.0;\nvar alert = null;\nif (data.suhu > threshold) {\n    alert = {\n        message: PERINGATAN: Suhu (${data.suhu}°C) melewati batas maksimal (${threshold}°C)!,\n        suhu: data.suhu,\n        threshold: threshold,\n        timestamp: data.received\n    };\n}\n\n// Output 1: Query SQLite\nvar sqlMsg = {\n    topic: INSERT INTO sensor_history (suhu, kelembaban, received) VALUES (${data.suhu}, ${data.kelembaban}, '${data.received}');\n};\n\n// Output 2: WebSocket Broadcast\nvar wsMsg = {\n    payload: JSON.stringify({\n        type: 'sensor_update',\n        data: data,\n        alert: alert\n    })\n};\n\n// Output 3: MQTT Alert (jika melewati batas)\nvar alertMqttMsg = null;\nif (alert) {\n    alertMqttMsg = {\n        topic: 'iot/alert',\n        payload: JSON.stringify(alert)\n    };\n}\n\nreturn [sqlMsg, wsMsg, alertMqttMsg];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "sqlite_insert"
            ],
            [
                "ws_out_sensor"
            ],
            [
                "mqtt_publish_alert"
            ]
        ]
    },
    {
        "id": "sqlite_insert",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlite_db_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Insert History",
        "x": 650,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "ws_out_sensor",
        "type": "websocket out",
        "z": "flow_api",
        "name": "Broadcast WS",
        "server": "ws_listener_config",
        "client": "",
        "x": 650,
        "y": 120,
        "wires": []
    },
    {
        "id": "mqtt_publish_alert",
        "type": "mqtt out",
        "z": "flow_api",
        "name": "Publish Alert",
        "topic": "",
        "qos": "0",
        "retain": "false",
        "broker": "mqtt_broker_config",
        "x": 650,
        "y": 160,
        "wires": []
    },
    {
        "id": "auth_check",
        "type": "function",
        "z": "flow_api",
        "name": "Auth Middleware (X-API-Key)",
        "func": "const VALID_API_KEY = 'rahasia-iot-2026';\nconst apiKey = msg.req.headers['x-api-key'];\n\nmsg.headers = {\n    'Access-Control-Allow-Origin': '',\n    'Content-Type': 'application/json'\n};\n\nif (!apiKey || apiKey !== VALID_API_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {\n        status: 'error',\n        message: 'Unauthorized: Invalid or missing X-API-Key'\n    };\n    return [null, msg]; // Output 2: Unauthorized response\n}\n\nreturn [msg, null]; // Output 1: Authorized, lanjutkan",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 320,
        "wires": [
            [
                "route_api"
            ],
            [
                "http_resp_global"
            ]
        ]
    },
    {
        "id": "route_api",
        "type": "switch",
        "z": "flow_api",
        "name": "Route Endpoint",
        "property": "req.url",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "/api/suhu",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "/api/history",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "/api/kontrol",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "/api/threshold",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 4,
        "x": 640,
        "y": 300,
        "wires": [
            [
                "resp_suhu"
            ],
            [
                "prep_history_sql"
            ],
            [
                "proc_kontrol"
            ],
            [
                "proc_threshold"
            ]
        ]
    },
