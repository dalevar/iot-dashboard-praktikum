    {
        "id": "resp_suhu",
        "type": "function",
        "z": "flow_api",
        "name": "Build Response Suhu",
        "func": "var data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null};\nvar threshold = flow.get('tempThreshold') || 30.0;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    threshold: threshold,\n    server_time: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 220,
        "wires": [
            [
                "http_resp_global"
            ]
        ]
    },
    {
        "id": "prep_history_sql",
        "type": "function",
        "z": "flow_api",
        "name": "Query SQLite History",
        "func": "msg.topic = 'SELECT suhu, kelembaban, received FROM sensor_history ORDER BY id DESC LIMIT 20;';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 270,
        "wires": [
            [
                "sqlite_select_history"
            ]
        ]
    },
    {
        "id": "sqlite_select_history",
        "type": "sqlite",
        "z": "flow_api",
        "mydb": "sqlite_db_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "Get 20 Records",
        "x": 1080,
        "y": 270,
